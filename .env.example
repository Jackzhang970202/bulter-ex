# Copy this file to .env and fill in your values.
# Never commit .env.

# Primary model channel (OpenAI-compatible)
LLM_MODEL=your-chat-model
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1

# Optional fallback channel (Anthropic-compatible); leave empty to disable
FALLBACK_MODEL=
FALLBACK_API_KEY=
FALLBACK_BASE_URL=

# Service
KNOWLENS_HOST=127.0.0.1
KNOWLENS_PORT=8633
# Data directory (defaults to ./data)
# KNOWLENS_HOME=/absolute/path/to/data
# Claude Code transcript root (optional)
# KNOWLENS_CC_ROOT=~/.claude/projects
# PDF backend: pdfplumber (permissive, default) or leave unset for auto
# KNOWLENS_PDF_BACKEND=pdfplumber
# Optional external zdata-agent-starter sidecar (agno agents/teams/workflows)
# ZDATA_BASE_URL=http://127.0.0.1:8080
